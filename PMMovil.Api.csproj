<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PMMovil.Api</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.*" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.*" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.14" />
    <PackageReference Include="MySqlConnector" Version="2.3.*" />
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="QuestPDF" Version="2024.10.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.*" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.*" />
    <PackageReference Include="Polly" Version="8.3.*" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.*" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.*" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.10" />
    <PackageReference Include="WebPush" Version="1.0.13" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las regresiones son un ejecutable aparte, no archivos del servidor web. -->
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <None Remove="Tests\**" />

    <!-- appsettings.Local.json es SOLO para desarrollo local (secretos que
         nunca van a git, ver .gitignore). Program.cs lo carga como overlay
         OPCIONAL sin importar el ambiente (AddJsonFile, no esta condicionado
         a ASPNETCORE_ENVIRONMENT); si este archivo llega al servidor de
         produccion, pisa en silencio las cadenas de conexion de .30/.29 con
         las de localhost/root. CopyToPublishDirectory=Never asegura que
         "dotnet publish" nunca lo incluya en la carpeta que se copia al
         servidor, aunque siga funcionando con "dotnet run" en local (que lee
         directo del directorio del proyecto, no del publish). -->
    <Content Update="appsettings.Local.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# vsc
.vscode/

# Environment files
appsettings.Local.json
appsettings.json
appsettings.Production.json
appsettings.Development.json

# Salida de "dotnet publish" -- puede traer appsettings.Local.json/
# .Development.json antes de que existiera el CopyToPublishDirectory=Never
# del .csproj. No debe versionarse; se regenera con cada publish.
publish/
publish-*/
verify-build*/

# Firebase service account (clave privada de envío FCM) -- nunca al repo.
firebase-service-account.json

# Codex / AI logs
.codex-logs/

# Archivos locales o publicados que no deben versionarse
*.zip
*.pfx
*.p12
*.pem
*.key
nul

# Claude / AI
.claude/
implementation_plan*.md
task.md
walkthrough.md

# OS files
.DS_Store
Thumbs.db
desktop.ini
